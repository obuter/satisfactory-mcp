{
  "uid": "frm-production",
  "title": "Satisfactory \u00b7 Production",
  "tags": [
    "satisfactory",
    "frm",
    "production"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
