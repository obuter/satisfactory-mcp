        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "max(resource_sink_total_points{sink_type=\"Resource\",session_name=~\"$session\"})",
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
