# Copy to .env in connector/ (and monitoring/ if you use it) and edit.

# --- FRM mod backend (both connector and monitoring) ---
# Address of the machine running Satisfactory with the Ficsit Remote Monitoring mod.
# Use its LAN IP if the game runs on a different box than the connector.
FRM_HOST=127.0.0.1
FRM_PORT=8080

# --- connector tuning (optional) ---
FRM_TIMEOUT=10
MAX_OUTPUT_CHARS=8000

# --- monitoring/ Grafana (only if you run the dashboards) ---
GF_SECURITY_ADMIN_USER=admin
# CHANGE THIS before exposing Grafana anywhere.
GF_SECURITY_ADMIN_PASSWORD=changeme
PROM_RETENTION=30d
